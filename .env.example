# ============================
# 🤖 LLM CONFIGURATION (Local)
# ============================

# For local development:
# If you run Ollama locally → use these:
# LLM_PROVIDER=ollama
# LLM_API_URL=http://localhost:11434/api/generate
# LLM_MODEL_NAME=phi3:mini

# If you want to test Gemini locally (optional):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=<YOUR_GEMINI_KEY>     # only if needed locally
# LLM_MODEL_NAME=gemini-1.5-flash       # or gemini-pro

LLM_PROVIDER=gemini
GEMINI_API_KEY=Your-own-API-Key-Here
LLM_MODEL_NAME=gemini-1.5-flash 

