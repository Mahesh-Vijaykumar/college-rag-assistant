# Security Settings
SECRET_KEY=your-super-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin Credentials
# IMPORTANT: Change these default credentials before deployment!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# File Storage
UPLOAD_DIR=../uploads
VECTOR_DB_DIR=../vector_db

# LLM Configuration
LLM_PROVIDER=gemini
LLM_API_URL=http://localhost:11434/api/generate
LLM_MODEL_NAME=phi3.5

# Gemini API (if using LLM_PROVIDER=gemini)
GEMINI_API_KEY=AIzaSyD5WeK1kr80LJzgsXJKNNnxMIeugZ5cgBE

# CORS Settings
# Comma-separated list of allowed origins (no spaces)
# For production, set this to your actual frontend URL
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Security Best Practices:
# 1. Generate a strong SECRET_KEY using: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 2. Use a strong admin password (minimum 12 characters, mix of letters, numbers, symbols)
# 3. In production, set ALLOWED_ORIGINS to your actual frontend domain only
# 4. Never commit the actual .env file to version control
# 5. Rotate SECRET_KEY and admin credentials periodically

